+def get_notebook_network_pyvis(graph, args=None):
+    """Create a PyVis view without changing the input graph or options.
+
+    Width/height accept CSS dimensions or pixel counts. ``cdn_resources`` is
+    passed to PyVis and defaults to inline network assets for portable output.
+    """
+    options = dict(args or {})
+    width = options.get('width', 800)
+    height = options.get('height', 850)
+    if isinstance(width, (int, float)):
